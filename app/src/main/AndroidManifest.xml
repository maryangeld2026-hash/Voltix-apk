<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Escritorio en el PC: servidor en la red del cable USB o la Wi‑Fi, y compartir la pantalla -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.usb.accessory" android:required="false" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Barra de tareas siempre visible encima de las apps (el usuario lo autoriza) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Traer al frente y minimizar ventanas de otras apps -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- Opcional: se concede una sola vez por ADB para activar el modo escritorio con un botón -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Ver todas las apps que se pueden abrir (Android 11+) -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <!-- Jarvis, el asistente: preguntarle desde el escritorio -->
        <package android:name="co.jarvis.docente" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NexoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nexo">

        <!-- Asistente en el teléfono -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- El escritorio que se muestra en el monitor -->
        <activity
            android:name=".DesktopActivity"
            android:exported="false"
            android:label="@string/desktop_label"
            android:launchMode="singleTask"
            android:taskAffinity="com.nexo.escritorio.desktop"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.Nexo.Desktop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|colorMode|layoutDirection|locale" />

        <!-- Puente invisible para abrir el escritorio desde el panel rápido -->
        <activity
            android:name=".LaunchDesktopActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/desktop_label"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Escritorio en el PC por el cable USB: navegador (red del cable) o programa Nexo PC (modo accesorio) -->
        <activity
            android:name=".pc.PcActivity"
            android:exported="true"
            android:label="Nexo: escritorio en el PC"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Nexo">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>

        <service
            android:name=".pc.PcService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Puerta para Jarvis: abrir el escritorio, apps en ventana, el touchpad… (invisible) -->
        <activity
            android:name=".NexoApiActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/desktop_label"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.nexo.escritorio.ORDEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Jarvis le devuelve a Nexo la respuesta de lo que le preguntaste desde el escritorio -->
        <receiver
            android:name=".JarvisRespuestaReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nexo.escritorio.JARVIS_RESPUESTA" />
            </intent-filter>
        </receiver>

        <!-- Touchpad: el teléfono controla el monitor -->
        <activity
            android:name=".TouchpadActivity"
            android:exported="false"
            android:label="Touchpad Nexo"
            android:launchMode="singleTask"
            android:taskAffinity="com.nexo.escritorio.touchpad"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- Asistente de Nexo (accesibilidad, opcional) -->
        <service
            android:name=".NexoAccessibility"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Shizuku: controles de ventana avanzados sin root -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Notificaciones en el centro de control (el usuario lo autoriza) -->
        <service
            android:name=".NotificationService"
            android:exported="true"
            android:label="@string/notif_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Mosaico «Escritorio» en los ajustes rápidos -->
        <service
            android:name=".DesktopTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
